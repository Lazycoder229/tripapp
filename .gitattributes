# Files listed here are kept in the repo (for local dev, CI, git history)
# but stripped out automatically by `git archive` and by GitHub's own
# "Download ZIP" / release tarballs — so end users / production deploys
# never see them, without moving anything or touching autoload paths.
/tests             export-ignore
/how-it-creates    export-ignore
/phpunit.xml       export-ignore
/.github            export-ignore
/.gitattributes     export-ignore
/docker-compose.yml export-ignore
/Dockerfile         export-ignore
/DEVELOPMENT.md     export-ignore
/deployment/nginx/docker.conf export-ignore

# Normalize line endings — lahat ng .php files mo ay CRLF ngayon (Windows),
# pero LF ang standard sa Linux servers. Hindi ito magiging isyu sa PHP
# execution mismo, pero maiiwasan ang messy diffs kung may kahit sinong
# mag-edit gamit ibang OS/editor.
*.php text eol=lf
*.md  text eol=lf
*.yml text eol=lf