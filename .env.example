# Application
APP_NAME="My Trip Framework"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:3000
APP_KEY=base64:your-generated-key-here

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trip_db
DB_USERNAME=root
DB_PASSWORD=

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Leave unset to auto-detect from request scheme; set explicitly (true/false)
# if you're behind a TLS-terminating proxy.
SESSION_SECURE=true

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# Cache
CACHE_DRIVER=file
CACHE_TTL=3600

# Logging
LOG_DRIVER=file
# emergency|alert|critical|error|warning|notice|info|debug — set to 'error' in
# production to drop info/debug noise; leave 'debug' locally to see everything.
LOG_LEVEL=debug


# Mail — NOT YET IMPLEMENTED. No Mailer class/config/mail.php exists yet in
# src/. These vars are placeholders for when that lands; setting them does
# nothing right now.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=hello@example.com
# MAIL_FROM_NAME="My Framework"

# CORS
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=86400

# File Storage
# 'private' = storage/app/uploads (not web-accessible, serve via a route)
# 'public'  = public/uploads (served directly by the web server)
FILESYSTEM_DRIVER=private
UPLOAD_MAX_SIZE=5242880

# Security
BCRYPT_ROUNDS=12
JWT_SECRET=your-jwt-secret-here
# Optional. Leave unset unless you need 'iss' claim checking (e.g. multiple
# services sharing one auth setup and you want to reject cross-issued tokens).
# JWT_ISSUER=
# Seconds a token stays valid. Defaults to 3600 (1 hour) if unset.
# JWT_TTL=3600
SECURITY_HSTS_ENABLED=true
SECURITY_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin

# Content-Security-Policy — off by default. Set to true to send the header,
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_CSP_DEFAULT_SRC="'self'"
SECURITY_CSP_SCRIPT_SRC="'self' https://cdn.jsdelivr.net"
SECURITY_CSP_STYLE_SRC="'self' 'unsafe-inline' https://fonts.googleapis.com"
SECURITY_CSP_IMG_SRC="'self' data:"
SECURITY_CSP_FONT_SRC="'self' https://fonts.gstatic.com"
SECURITY_CSP_CONNECT_SRC="'self' https://cdn.jsdelivr.net"
SECURITY_CSP_FRAME_ANCESTORS="'none'"
SECURITY_CSP_FORM_ACTION="'self'"
SECURITY_CSP_BASE_URI="'self'"
SECURITY_CSP_EXTRA=