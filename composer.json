{
    "name": "lazycoder229/tripphp",
    "description": "Trip PHP Framework — a lightweight PHP 8.4 micro-framework with a attribute-based routing, and a built-in DI container.",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Framework\\": "src/",
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "scripts": {
        "test": "phpunit"
    }
}