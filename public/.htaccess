# ============================================================================
# PUBLIC .htaccess — Front Controller + Security Headers + Performance
# ============================================================================
# Ang file na ito ang pangunahing request handler ng Trip Framework.
# Lahat ng HTTP request na dumadaan dito ay nire-route sa index.php
# (Front Controller pattern), maliban sa mga totoong static files.
# ============================================================================

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Kung naka-subdirectory sa shared hosting
    # (e.g. yourdomain.com/trip), i-uncomment at i-edit ito:
    # RewriteBase /trip/public/

    # --------------------------------------------------
    # Handle Authorization Header para sa JWT at API Keys
    # --------------------------------------------------
    # Maraming shared hosting ang nag-strip ng Authorization header.
    # Ang tatlong rules na ito ang fallback chain para ma-capture ito.

    # Method 1: Standard rewrite passthrough
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Method 2: CGI/FastCGI fallback via HTTP_AUTHORIZATION
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Method 3: Kung ang server ay gumagamit ng REDIRECT_ prefix
    RewriteCond %{ENV:REDIRECT_HTTP_AUTHORIZATION} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{ENV:REDIRECT_HTTP_AUTHORIZATION}]

    # --------------------------------------------------
    # Force HTTPS (i-uncomment kung may SSL certificate na)
    # --------------------------------------------------
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --------------------------------------------------
    # Redirect www sa non-www (o baliktad — piliin isa lang)
    # --------------------------------------------------
    # Option A: www → non-www (i-uncomment kung ito ang gusto)
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Option B: non-www → www (i-uncomment kung ito ang gusto)
    # RewriteCond %{HTTP_HOST} !^www\. [NC]
    # RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --------------------------------------------------
    # Redirect Trailing Slashes (kung hindi directory)
    # --------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # --------------------------------------------------
    # Front Controller — i-send lahat ng requests sa index.php
    # --------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ============================================================================
# SECURITY HEADERS
# ============================================================================
<IfModule mod_headers.c>
    # Pigilan ang MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Pigilan ang clickjacking / iframe embedding
    Header always set X-Frame-Options "DENY"

    # Kontrolin ang referrer information na ipinapadala
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # I-enable ang XSS protection sa mga lumang browser
    Header always set X-XSS-Protection "1; mode=block"

    # Pigilan ang caching ng sensitibong API responses
    # (i-uncomment kung pure API ang app, walang static assets)
    # Header always set Cache-Control "no-store, no-cache, must-revalidate"
    # Header always set Pragma "no-cache"

    # Tanggalin ang server technology exposure
    Header always unset X-Powered-By
    Header always unset Server

    # HSTS — i-uncomment PAGKATAPOS ma-confirm ang stable HTTPS setup
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Permissions-Policy — i-limit ang browser features na ginagamit
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Content-Security-Policy (basic — i-adjust depende sa app)
    # Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none';"
</IfModule>

# ============================================================================
# BLOCK SENSITIVE FILES — kahit nasa public/ accidentally na-upload
# ============================================================================

# I-block ang dotfiles (.env, .git, .htaccess backups, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# I-block ang PHP files na hindi index.php
# (extra protection — sa case na may rogue PHP file na na-upload)
# I-uncomment kung confident ka na index.php lang ang kailangan sa public/:
# <FilesMatch "\.php$">
#     <IfModule mod_authz_core.c>
#         Require all denied
#     </IfModule>
# </FilesMatch>
# <Files "index.php">
#     <IfModule mod_authz_core.c>
#         Require all granted
#     </IfModule>
# </Files>

# ============================================================================
# PERFORMANCE — Compression at Caching para sa static assets
# ============================================================================

# --------------------------------------------------
# GZIP Compression
# --------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2
</IfModule>

# --------------------------------------------------
# Browser Caching para sa static assets
# --------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # CSS at JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # HTML — huwag i-cache nang matagal (dynamic content)
    ExpiresByType text/html "access plus 0 seconds"

    # JSON API responses — huwag i-cache
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# --------------------------------------------------
# ETag — i-disable para consistency sa load-balanced setups
# --------------------------------------------------
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# --------------------------------------------------
# UTF-8 encoding bilang default
# --------------------------------------------------
AddDefaultCharset UTF-8

# --------------------------------------------------
# Limit ang request body size (50MB max — i-adjust kung kailangan)
# --------------------------------------------------
# LimitRequestBody 52428800

# --------------------------------------------------
# Disable directory listing
# --------------------------------------------------
Options -Indexes
