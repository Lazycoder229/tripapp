# ============================================================================
# ROOT .htaccess — Shared Hosting / cPanel / Apache
# ============================================================================
# Ang file na ito ang unang defense layer kapag ang DocumentRoot ng shared
# hosting ay nakaturo sa root folder ng project (hindi sa public/).
#
# Dalawang tungkulin nito:
#   1. I-redirect LAHAT ng request papunta sa public/ subfolder.
#   2. I-block ang direktang access sa lahat ng sensitibong files/folders
#      kung sakaling ma-bypass ang rewrite (e.g. disabled mod_rewrite).
# ============================================================================

# --------------------------------------------------
# 1) Rewrite — i-forward lahat ng traffic sa public/
# --------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Kung ang shared hosting ay nag-set ng subdirectory bilang base
    # (e.g. yourdomain.com sa ~/public_html/trip), i-uncomment at i-edit ito:
    # RewriteBase /trip/

    # Huwag i-rewrite kung nasa public/ na ang request
    RewriteRule ^public/ - [L]

    # I-redirect lahat papuntang public/ folder
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# --------------------------------------------------
# 2) I-block ang access sa LAHAT ng dotfiles (.env, .git, .gitignore, etc.)
# --------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^\.|/\.) - [F,L]
</IfModule>

# Fallback kung walang mod_rewrite
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        # Apache 2.4+
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        # Apache 2.2
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --------------------------------------------------
# 3) I-block ang direktang access sa sensitibong directories
#    Proteksyon kung sakaling ma-bypass ang mod_rewrite.
# --------------------------------------------------

# Block: app/ (Controllers, Models, Middleware, Views source code)
<IfModule mod_rewrite.c>
    RewriteRule ^app/ - [F,L]
</IfModule>

# Block: config/ (database credentials, JWT secrets, etc.)
<IfModule mod_rewrite.c>
    RewriteRule ^config/ - [F,L]
</IfModule>

# Block: storage/ (logs, cache, sessions)
<IfModule mod_rewrite.c>
    RewriteRule ^storage/ - [F,L]
</IfModule>

# Block: database/ (migrations, SQL files)
<IfModule mod_rewrite.c>
    RewriteRule ^database/ - [F,L]
</IfModule>

# Block: vendor/ (Composer dependencies — may source code at internal paths)
<IfModule mod_rewrite.c>
    RewriteRule ^vendor/ - [F,L]
</IfModule>

# Block: src/ (Framework source code)
<IfModule mod_rewrite.c>
    RewriteRule ^src/ - [F,L]
</IfModule>

# Block: deployment/ (Nginx configs, PHP configs)
<IfModule mod_rewrite.c>
    RewriteRule ^deployment/ - [F,L]
</IfModule>

# Block: tests/ (PHPUnit tests)
<IfModule mod_rewrite.c>
    RewriteRule ^tests/ - [F,L]
</IfModule>

# --------------------------------------------------
# 4) I-block ang access sa mga sensitibong individual files sa root
# --------------------------------------------------
<FilesMatch "^(composer\.(json|lock)|phpunit\.xml|Dockerfile|docker-compose\.yml|deploy\.sh|trip|\.gitignore|README\.md|DEPLOYMENT\.md|Model\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --------------------------------------------------
# 5) Disable directory listing sa buong project
# --------------------------------------------------
Options -Indexes

# --------------------------------------------------
# 6) Disable server signature (bawasan ang info leak)
# --------------------------------------------------
ServerSignature Off
